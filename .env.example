# Docker uses the internal postgres hostname. Change only for a local backend run.
DATABASE_URL=postgresql+psycopg://fitlife:fitlife@postgres:5432/fitlife
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_MINUTES=10080
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=llama3.2:3b
LLM_TIMEOUT_SECONDS=45
VERTEX_MODEL=gemini-3.5-flash
VERTEX_THINKING_BUDGET=0
VECTOR_DB_PATH=/data/vectors
CORS_ORIGINS=http://localhost:5180
VITE_API_URL=http://localhost:8010/api/v1
